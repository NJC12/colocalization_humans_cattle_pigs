initialize() {
    initializeSLiMOptions(keepPedigrees=F);
    // initializeTreeSeq(simplificationRatio=50);
    initializeTreeSeq();
    defineConstant("Q", Q_scaling);
    defineConstant("L", length);
    defineConstant("burn_in", 0);
    defineConstant("pop_names", c("Holstein_Friesian"));
    defineConstant("input_file", file_in);
    defineConstant("output_dir", dir_out);
    defineConstant("output_file", file_out);
    defineConstant("starting_tick", tick);

    // Recombination rate comes from the caller (config key `recombination_rate`)
    // rather than a literal -- see farm_burn_in_e2.slim for why.
    if (!exists("recomb_rate"))
        stop("ERROR: -d recomb_rate=<float> is required (config key `recombination_rate`)");
    // Q-scaled per-tick rate. Exact at Q == 1, where it reduces to recomb_rate;
    // the old `if (Q != 1)` guard left this unassigned at Q == 1 and the next
    // line then referenced it, which the Q=1 deep-history run would hit.
    defineConstant("recombination_rates", (1 - (1 - 2 * recomb_rate)^Q) / 2);
    defineConstant("recombination_ends", L-1);
    initializeRecombinationRate(recombination_rates, recombination_ends);
    defineConstant("metadata", Dictionary("Q", Q));

    // Index 0 is a dummy padding entry so epoch N maps to index N (matches
    // farm_selection_from_ep8.slim). Index 1 (17000 / 29800) is epoch 1, which
    // is the burn-in -- it is replaced by the read-in checkpoint, not re-run here.
    defineConstant("ep_sizes",   c(0, 17000, 10000, 7000, 3500, 2500, 2000, 1500, 1000, 350, 250, 120, 90));
    defineConstant("ep_lengths", c(0, 29800,  1000,  600, 1100,  200,  300,  130,    6,   6,   6,   3,   3));

    // Neutral mutations will be added later
    // Two categories of deleterious mutations: m1 & m2
    // One category of positive mutations: m3
    // m1: non-coding deleterious mutations
    // m2: coding deleterious mutations
    // The ratio is 5:1 because we care only about the
    // non-neutral fraction of the genome, which is enriched for coding
    // We will also add a small number of positively selected mutations
    initializeMutationType("m1", 0.5, "e", Q * -4e-4); // Negative because deleterious
    initializeMutationType("m2", 0.5, "g", Q * -0.03, 0.206);
    initializeMutationType("m3", 0.5, "e", Q * 0.005);
    initializeGenomicElementType("g1", c(m1, m2, m3), c(0.975, 0.024, 0.001));
    initializeGenomicElement(g1, 0, L-1);
    initializeMutationRate(Q * 5.6e-9, c(L-1)); // DFE-applied rate = 1.4e-8 * 0.4 (unscaled); neutral 8.4e-9 added downstream

    defineGlobal("startE2", -1);
    defineGlobal("startE3", -1);
    defineGlobal("startE4", -1);
    defineGlobal("startE5", -1);
    defineGlobal("startE6", -1);
    defineGlobal("startE7", -1);
    defineGlobal("startE8", -1);
    defineGlobal("startE9", -1);
    defineGlobal("startE10", -1);
    defineGlobal("startE11", -1);
    defineGlobal("startE12", -1);
    defineGlobal("end_tick", -1);
}

// Epoch 1 == the burn-in. Read its equilibrated endpoint, confirm the size,
// then schedule every subsequent epoch boundary up front.
1 late() {
    sim.readFromPopulationFile(file_in);
    print("File read in at tick " + sim.cycle);
    for (subpop in sim.subpopulations) {
        print(" - " + subpop.id + ": " + subpop.individualCount + " individuals");
    }

    // Confirm the burn-in population matches the epoch-1 size (17000/Q).
    expected_size = asInteger(ep_sizes[1] / Q);
    if (p0.individualCount != expected_size)
        stop("ERROR: read-in pop size " + p0.individualCount +
             " != expected epoch-1 size " + expected_size + " (ep_sizes[1]/Q)");

    // Precompute every epoch boundary relative to the read-in tick. A bare
    // assignment inside an event creates a throwaway local (Eidos R-style
    // scoping; see SLiM issue #430), so cross-tick state MUST go through
    // defineGlobal(). Epoch 2 (size 10000/Q = 1M) begins one tick after read-in.
    defineGlobal("startE2",  sim.cycle + 1);
    defineGlobal("startE3",  asInteger(startE2  + ep_lengths[2]/Q));
    defineGlobal("startE4",  asInteger(startE3  + ep_lengths[3]/Q));
    defineGlobal("startE5",  asInteger(startE4  + ep_lengths[4]/Q));
    defineGlobal("startE6",  asInteger(startE5  + ep_lengths[5]/Q));
    defineGlobal("startE7",  asInteger(startE6  + ep_lengths[6]/Q));
    defineGlobal("startE8",  asInteger(startE7  + ep_lengths[7]/Q));
    defineGlobal("startE9",  asInteger(startE8  + ep_lengths[8]/Q));
    defineGlobal("startE10", asInteger(startE9  + ep_lengths[9]/Q));
    defineGlobal("startE11", asInteger(startE10 + ep_lengths[10]/Q));
    defineGlobal("startE12", asInteger(startE11 + ep_lengths[11]/Q));
    defineGlobal("end_tick", asInteger(startE12 + ep_lengths[12]/Q));
    print("Current tick: " + sim.cycle);
    print("Scheduled startE2=" + startE2 + " ... startE12=" + startE12 + " end_tick=" + end_tick);
}

// Epoch driver. Runs every tick after the read-in (guard is tick-agnostic: it
// engages on the first tick after the `1 late()` read regardless of the burn-in
// checkpoint's stored tick). All boundaries were precomputed in `1 late()`.
2: early() {
    if (sim.cycle % 100 == 0) {
        print("Tick " + sim.cycle);
    }

    if (sim.cycle % 10000 == 0) {
        sim.treeSeqSimplify();
        sim.treeSeqOutput(output_dir + output_file + ".tick_" + sim.cycle + ".ts", metadata=metadata);
    }

    // Epoch 2 -- begins one tick after read-in; size 10000/Q = 1M.
    if (sim.cycle == startE2) {
        p0.setSubpopulationSize(asInteger(ep_sizes[2]/Q));
        print("Epoch 2 begins - tick " + sim.cycle);
    }

    // Epoch 3
    if (sim.cycle == startE3) {
        sim.treeSeqSimplify();
        sim.treeSeqOutput(output_dir + output_file + ".ep2.ts", metadata=metadata);
        p0.setSubpopulationSize(asInteger(ep_sizes[3]/Q));
        print("Epoch 3 begins - tick " + sim.cycle);
    }

    // Epoch 4
    if (sim.cycle == startE4) {
        sim.treeSeqSimplify();
        sim.treeSeqOutput(output_dir + output_file + ".ep3.ts", metadata=metadata);
        p0.setSubpopulationSize(asInteger(ep_sizes[4]/Q));
        print("Epoch 4 begins - tick " + sim.cycle);
    }

    // Epoch 5
    if (sim.cycle == startE5) {
        sim.treeSeqSimplify();
        sim.treeSeqOutput(output_dir + output_file + ".ep4.ts", metadata=metadata);
        p0.setSubpopulationSize(asInteger(ep_sizes[5]/Q));
        print("Epoch 5 begins - tick " + sim.cycle);
    }

    // Epoch 6
    if (sim.cycle == startE6) {
        sim.treeSeqSimplify();
        sim.treeSeqOutput(output_dir + output_file + ".ep5.ts", metadata=metadata);
        p0.setSubpopulationSize(asInteger(ep_sizes[6]/Q));
        print("Epoch 6 begins - tick " + sim.cycle);
    }

    // Epoch 7
    if (sim.cycle == startE7) {
        sim.treeSeqSimplify();
        sim.treeSeqOutput(output_dir + output_file + ".ep6.ts", metadata=metadata);
        p0.setSubpopulationSize(asInteger(ep_sizes[7]/Q));
        print("Epoch 7 begins - tick " + sim.cycle);
    }

    // Epoch 8
    if (sim.cycle == startE8) {
        sim.treeSeqSimplify();
        sim.treeSeqOutput(output_dir + output_file + ".ep7.ts", metadata=metadata);
        p0.setSubpopulationSize(asInteger(ep_sizes[8]/Q));
        print("Epoch 8 begins - tick " + sim.cycle);
    }

    // Epoch 9 -- writes the epoch-8 checkpoint that cattle_sel / from_midpoint
    // consume. The name MUST match helpers/paths.py:stage1_cattle_baseline_epoch_8
    // (".epoch_8.ts"); an earlier ".ep8.ts" here broke the from-ep8 lookup.
    if (sim.cycle == startE9) {
        sim.treeSeqSimplify();
        sim.treeSeqOutput(output_dir + output_file + ".epoch_8.ts", metadata=metadata);
        p0.setSubpopulationSize(asInteger(ep_sizes[9]/Q));
        print("Epoch 9 begins - tick " + sim.cycle);
    }

    // Epoch 10
    if (sim.cycle == startE10) {
        sim.treeSeqSimplify();
        sim.treeSeqOutput(output_dir + output_file + ".ep9.ts", metadata=metadata);
        p0.setSubpopulationSize(asInteger(ep_sizes[10]/Q));
        print("Epoch 10 begins - tick " + sim.cycle);
    }

    // Epoch 11
    if (sim.cycle == startE11) {
        sim.treeSeqSimplify();
        sim.treeSeqOutput(output_dir + output_file + ".ep10.ts", metadata=metadata);
        p0.setSubpopulationSize(asInteger(ep_sizes[11]/Q));
        print("Epoch 11 begins - tick " + sim.cycle);
    }

    // Epoch 12
    if (sim.cycle == startE12) {
        sim.treeSeqSimplify();
        sim.treeSeqOutput(output_dir + output_file + ".ep11.ts", metadata=metadata);
        p0.setSubpopulationSize(asInteger(ep_sizes[12]/Q));
        print("Epoch 12 begins - tick " + sim.cycle);
    }

    // End of simulation
    if (sim.cycle == end_tick) {
        sim.treeSeqSimplify();
        sim.treeSeqOutput(output_dir + output_file + ".full.ts", metadata=metadata);
        sim.simulationFinished();
    }
}

10000000 early() {
    print("This is just a placeholder tick (slim won't run past the highest named tick). If you see this message, something is wrong.");
}

