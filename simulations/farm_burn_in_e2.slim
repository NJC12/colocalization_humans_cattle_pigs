initialize() {
    // initializeSLiMOptions(keepPedigrees=F, mutationRuns=1);
    initializeSLiMOptions(keepPedigrees=F);
    initializeTreeSeq();
    defineConstant("Q", Q_scaling);
    defineConstant("L", length);
    defineConstant("burn_in", 0);
    defineConstant("pop_names", c("Holstein_Friesian"));
    defineConstant("input_file", file_in);
    defineConstant("output_file", file_out);
    defineConstant("output_dir", dir_out);

    // Recombination rate comes from the caller (config key `recombination_rate`)
    // rather than a literal. The old literal 9.26e-09 disagreed with the 1.3e-8
    // that farm_create_orig_pop_e2.py used for the msprime stage feeding this
    // script, so the deep genealogy and the forward phase had different maps.
    if (!exists("recomb_rate"))
        stop("ERROR: -d recomb_rate=<float> is required (config key `recombination_rate`)");
    // Q-scaled per-tick rate. Exact at Q == 1, where it reduces to recomb_rate;
    // the old `if (Q != 1)` guard left this unassigned at Q == 1 and the next
    // line then referenced it, which the Q=1 deep-history run would hit.
    defineConstant("recombination_rates", (1 - (1 - 2 * recomb_rate)^Q) / 2);
    defineConstant("recombination_ends", L-1);
    initializeRecombinationRate(recombination_rates, recombination_ends);
    defineConstant("metadata", Dictionary("Q", Q));

    // Neutral mutations will be added later
    // Two categories of deleterious mutations: m1 & m2
    // One category of positive mutations: m3
    // m1: non-coding deleterious mutations
    // m2: coding deleterious mutations
    // The ratio is 5:1 because we care only about the
    // non-neutral fraction of the genome, which is enriched for coding
    // We will also add a small number of positively selected mutations
    initializeMutationType("m1", 0.5, "e", Q * -4e-4); // Negative because deleterious
    initializeMutationType("m2", 0.5, "g", Q * -0.03, 0.206);
    initializeMutationType("m3", 0.5, "e", Q * 0.005);
    initializeGenomicElementType("g1", c(m1, m2, m3), c(0.975, 0.024, 0.001));
    initializeGenomicElement(g1, 0, L-1);
    initializeMutationRate(Q * 5.6e-9, c(L-1)); // DFE-applied rate = 1.4e-8 * 0.4 (unscaled); neutral 8.4e-9 added downstream

}


1 late() {
    sim.readFromPopulationFile(file_in);
    cat("File read in\n\tTick 000: #");
    // sim.treeSeqRememberIndividuals(p0.individuals);
}

2: late() {
    if (sim.cycle % 100 == 0) { 
	cat("\n\tTick " + sim.cycle + ": ");
    }
    if (sim.cycle % 10 == 0) {
        cat("#");
    }
    if (sim.cycle % asInteger(10/Q) == 0) {
        // sim.treeSeqSimplify();
        sim.treeSeqOutput(dir_out + file_out + ".cycle_" + sim.cycle + ".ts", metadata=metadata);
    }
}

// Save equilibrated population
// End at tick 25000 (matches stage1_cattle_burn_in rule's expected
// cycle_25000.ts output and cattle_baseline.yaml's burn_in_cycle: 25000).
// Previously this was `asInteger(30000/Q) late()` which at Q=0.01 became
// tick 3,000,000 -- effectively non-terminating. The cycle_25000.ts
// checkpoint is the only output downstream stages consume.
25000 late() {
    sim.treeSeqOutput(dir_out + file_out + ".ts", metadata=metadata);
    sim.simulationFinished();
}
