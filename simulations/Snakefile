# Top-level Snakefile.
#
# Run with one of:
#   snakemake --configfile config/human.yaml ...
#   snakemake --configfile config/cattle_baseline.yaml ...
#   snakemake --configfile config/cattle_sel_bottlenecked.yaml ...
#   snakemake --configfile config/cattle_sel_not_bottlenecked.yaml ...
#
# The dispatcher includes the right stage-1 module based on
# `config["pipeline"]`, then includes the shared common rules. The default
# target (`rule all`) requests the stage-4 + stage-5 outputs.

import os
import sys

# Make ./helpers importable so rule modules can use search_dirs.find_or_canonical.
SIM_REPO_DIR = os.path.dirname(os.path.abspath(workflow.snakefile))
sys.path.insert(0, SIM_REPO_DIR)

from helpers import cattle_demography, human_demography, params_record, paths, search_dirs


# ---------- config validation + defaults ----------

REQUIRED_KEYS = [
    "pipeline", "species", "basename",
    "Q_scaling", "L", "min_maf", "gwas_scaling", "gtex_scaling", "gtex_size", "gwas_size",
    "stage1_seed", "workdir",
    # No setdefault for recombination_rate on purpose, same reasoning as Q_scaling:
    # it used to be an invisible literal that differed between the cattle msprime
    # stage (1.3e-8), the cattle SLiM stages (9.26e-9) and the human arm
    # (1.282e-8, inherited from stdpopsim). A silent default would let that drift
    # back. Round-2 configs predate the key -- add the value that run actually
    # used to reproduce it, or 1.3e-8 for round 3.
    "recombination_rate",
]
for k in REQUIRED_KEYS:
    if k not in config:
        raise ValueError(f"Missing required config key: {k}")

if config["pipeline"] not in {"human", "human_neutral", "cattle_baseline",
                              "cattle_baseline_from_midpoint", "cattle_sel",
                              "cattle_neutral"}:
    raise ValueError(f"Unknown pipeline: {config['pipeline']!r}")

if config["pipeline"] in {"human_neutral", "cattle_neutral"}:
    # No setdefault, same reasoning as recombination_rate above: the selected arms
    # split their 1.4e-8 into a DFE-applied 5.6e-9 and a neutral 8.4e-9 overlay,
    # and which of the three numbers a neutral arm uses decides whether its variant
    # density matches theirs. A silent default would make that invisible.
    #
    # The right number differs by species, because the two families put the split
    # in different places. The human arms apply BOTH halves in stage 1, so
    # human_neutral must ask for the 1.4e-8 total. The cattle arms apply 5.6e-9 in
    # SLiM and let create_gwas_files_and_phenotypes.py overlay 8.4e-9 -- and that
    # overlay runs unconditionally on the --cattle_ts_file branch -- so
    # cattle_neutral must ask for 5.6e-9 and let stage 2 finish the job. Passing
    # one arm's number to the other silently mis-sets variant density by 2.5x.
    if "mutation_rate" not in config:
        expected = ("the TOTAL rate of the arm being compared against, 1.4e-8, not its "
                    "neutral component"
                    if config["pipeline"] == "human_neutral" else
                    "the STAGE-1 component only, 5.6e-9; stage 2's add_neutral overlays "
                    "the remaining 8.4e-9 on the cattle branch")
        raise ValueError(
            f"{config['pipeline']} pipeline requires config key: mutation_rate "
            f"({expected})"
        )

if config["pipeline"] == "cattle_sel":
    for k in ("selection_multiplier", "selected_generations", "num_muts_selected",
              "continue_bottlenecking", "cattle_baseline_seed"):
        if k not in config:
            raise ValueError(f"cattle_sel pipeline requires config key: {k}")

if config["pipeline"] == "cattle_baseline_from_midpoint":
    if "cattle_baseline_seed" not in config:
        raise ValueError(
            "cattle_baseline_from_midpoint pipeline requires config key: cattle_baseline_seed"
        )

# Defaults
config.setdefault("already_includes_neutral", True)
# Which human demographic model stage 1 runs, and which of its populations it
# samples. OutOfAfrica_2T12 is every arm through category L; FinnishWang2014 is
# the demes graph categories M (FIN) and N (NFE) run. Both defaulted rather than
# required so every config written before the keys existed keeps producing
# hts_{seed}.ts and stays adoptable.
#
# ORDER MATTERS: the population default comes from the MODEL, so the model has
# to be resolved first. A config that names FinnishWang2014 and no population
# gets FIN, not EUR -- EUR is not a population of that model at all.
config.setdefault("demographic_model", human_demography.DEFAULT_MODEL)
human_demography.validate_model(config["demographic_model"])
config.setdefault(
    "population",
    human_demography.default_population(config["demographic_model"]))
human_demography.validate_population(config["population"],
                                     config["demographic_model"])
# Only the `human` pipeline reads either key. The cattle pipelines have no such
# choice, and human_neutral (category H) pins OutOfAfrica_2T12/EUR as constants
# of its own so it cannot drift from A. Setting either key anywhere else would
# be silently ignored, and silently ignored is how an arm ends up not being the
# arm someone thinks they ran -- so refuse instead.
if config["pipeline"] != "human":
    for _k, _default in (("demographic_model", human_demography.DEFAULT_MODEL),
                         ("population", human_demography.DEFAULT_POPULATION)):
        if config[_k] != _default:
            raise ValueError(
                f"{_k}={config[_k]!r} is read only by the `human` pipeline, "
                f"but this config runs {config['pipeline']!r}, which would "
                "ignore it."
            )
config.setdefault("neutral_trait_vars", False)
# Categories H and I (pipelines human_neutral / cattle_neutral). The two neutral
# models are not composable -- see create_gwas_files_and_phenotypes.py, which
# rejects the combination -- so catch it here rather than after stage 1 has run.
config.setdefault("synthetic_dfe_effects", False)
if config["synthetic_dfe_effects"] and config["neutral_trait_vars"]:
    raise ValueError(
        "synthetic_dfe_effects and neutral_trait_vars are mutually exclusive: they are "
        "two different neutral models. Categories H and I set the former; B and D set "
        "the latter."
    )
# Must a central causal locus segregate in the GTEx panel to be eligible?
#
# True intersects the causal pool with that panel, so every GWAS causal locus has
# a GTEx partner by construction. False does not, so the shared GTEx set is only
# whichever drawn loci that panel carries and the rest of its central slots are
# topped up uniformly -- a GWAS locus can then have no partner and cannot
# colocalize at all. Read {h,c}gwas_trait_partners_*.tsv before comparing a
# colocalization rate from a False arm against one from a True arm.
#
# "auto" is the rule this key replaces: intersect iff the draw is uniform AND the
# effect sizes are the variants' own. That rule made two conditions unreachable --
# a uniform draw without the intersection, and a synthetic-DFE or power draw with
# it -- which is why it is now set rather than derived. "auto" emits no path
# segment and reproduces every pre-existing run exactly.
config.setdefault("require_gtex_partner", paths.LEGACY_REQUIRE_GTEX_PARTNER)
# Normalised to 'auto' / True / False rather than taken as given, because the
# string "False" is TRUTHY. If --config ever hands us the unparsed string -- a
# quoting slip in a launcher, a YAML that wrote the value in quotes -- then
# `if config[...]` would read False as True and silently run the intersecting arm
# under the non-intersecting arm's name. The two differ only in this key, so
# nothing downstream would look wrong.
_rgp = config["require_gtex_partner"]
if isinstance(_rgp, str):
    _rgp_norm = {"auto": paths.LEGACY_REQUIRE_GTEX_PARTNER,
                 "true": True, "false": False}.get(_rgp.strip().lower())
    if _rgp_norm is None:
        raise ValueError(
            f"require_gtex_partner must be 'auto', True or False, got {_rgp!r}"
        )
    config["require_gtex_partner"] = _rgp_norm
elif isinstance(_rgp, bool):
    pass
else:
    raise ValueError(
        f"require_gtex_partner must be 'auto', True or False, got {_rgp!r}"
    )
if (config["require_gtex_partner"] != paths.LEGACY_REQUIRE_GTEX_PARTNER
        and config["require_gtex_partner"] and config["neutral_trait_vars"]):
    # Untested combination: under neutral_trait_vars the causal variant is the
    # RECIPIENT of a moved effect, so "present in both panels" has to be tested on
    # the recipient rather than the donor. The code does that, but no run has ever
    # exercised it, and these categories are not part of the publication set.
    raise ValueError(
        "require_gtex_partner=True with neutral_trait_vars=True has never been "
        "run. The recipient pool does carry the intersection, but nothing "
        "verifies it end to end -- add a test before enabling this combination."
    )
# Categories O and P: keep only this fraction of the NEUTRAL (selco == 0) sites,
# which is distributionally identical to having run the 8.4e-9 neutral overlay at
# `neutral_keep_fraction * 8.4e-9` (Poisson thinning) -- see
# helpers/neutral_thinning.py. 1.0 keeps everything and emits no path segment, so
# every arm that predates the key is unaffected.
config.setdefault("neutral_keep_fraction", paths.NO_NEUTRAL_THINNING)
if not (0 < float(config["neutral_keep_fraction"]) <= 1):
    raise ValueError(
        f"neutral_keep_fraction must be in (0, 1], got "
        f"{config['neutral_keep_fraction']!r}"
    )
# Thinning is only meaningful where the neutral class is BACKGROUND. Under
# synthetic_dfe_effects (H, I, K, L) the causal loci ARE the neutral variants, and
# under neutral_trait_vars (B, D) the effect RECIPIENTS are, so thinning would
# halve the one pool those categories are defined by while looking like a change
# to variant density. Refuse rather than silently produce a fifth neutral model.
if float(config["neutral_keep_fraction"]) != paths.NO_NEUTRAL_THINNING:
    for _k in ("synthetic_dfe_effects", "neutral_trait_vars"):
        if config[_k]:
            raise ValueError(
                f"neutral_keep_fraction={config['neutral_keep_fraction']!r} cannot be "
                f"combined with {_k}=True: that category draws its causal loci from "
                "the selco == 0 variants, so thinning them changes the causal pool "
                "rather than the background. Categories O and P thin A's and E's "
                "genomes, where the causal pool is selco != 0 and is untouched."
            )

# MAF floor a variant must clear to be eligible as CAUSATIVE: the central
# selected pool, the central neutral recipient pool used under
# neutral_trait_vars, and the flanking GTEx-only loci.
#
# This is one of three independent MAF floors, and it is the only one that
# touches stage-2 content:
#   causal_min_maf  which variants may be selected as causative      (stage 2)
#   fm_min_maf      which variants are fine-mapped (the DAP-G SBAMS) (stage 3)
#   min_maf         which variants enter the GWAS (plink2 --maf)     (stage 5)
# They are set separately. Note the default is NOT config["min_maf"] --
# defaulting one floor to another would couple two knobs that are meant to move
# independently.
#
# The default is 0 (no floor), and the floor applies in BOTH sampling schemes
# whenever it is set. It used to default to 0.01 and to be ignored by the central
# pool under causal_sampling=power. Every config in config/ pins the value
# explicitly so that change is inert for them; a hand-rolled --config invocation
# that omits the key now gets 0 rather than 0.01.
config.setdefault("causal_min_maf", paths.DEFAULT_CAUSAL_MIN_MAF)
if not (0 <= float(config["causal_min_maf"]) <= 0.5):
    raise ValueError(
        f"causal_min_maf must be in [0, 0.5], got {config['causal_min_maf']!r}"
    )

# How the central causal loci are drawn. "uniform" is the historical scheme (a
# uniform draw from the causal_min_maf-eligible pool) and emits no path segment;
# "power" weights every central selco != 0 variant by its probability of being
# detected in a GWAS of sampling_gwas_n individuals and draws with inclusion
# probability proportional to that power (helpers/causal_power.py).
#
# causal_min_maf gates the central pool under both schemes (it did not always --
# "power" used to drop the floor there on the grounds that the weight subsumed
# it), so the two keys compose rather than one shadowing the other.
config.setdefault("causal_sampling", paths.LEGACY_CAUSAL_SAMPLING)
if config["causal_sampling"] not in {"uniform", "power"}:
    raise ValueError(
        f"causal_sampling must be 'uniform' or 'power', got {config['causal_sampling']!r}"
    )
# Defaults to the config's own GWAS size, so the weight describes the GWAS this run
# actually simulates unless deliberately told otherwise. Set it higher to ask "which
# loci would a larger study find?" -- that shifts the causal set toward rarer,
# smaller-effect variants without changing the simulated GWAS itself.
config.setdefault("sampling_gwas_n", config["gwas_size"])
if float(config["sampling_gwas_n"]) <= 0:
    raise ValueError(f"sampling_gwas_n must be positive, got {config['sampling_gwas_n']!r}")
# Genome-wide significance, matching GWAS_SIG_P in figure2_revision2.ipynb so the
# sampling weight and the notebook's "GWAS-findable" filter use one rule.
config.setdefault("sampling_sig_p", 5e-8)
if not (0 < float(config["sampling_sig_p"]) < 1):
    raise ValueError(f"sampling_sig_p must be in (0, 1), got {config['sampling_sig_p']!r}")
# Sanity guard on the draw: refuse to run unless at least
# sampling_min_pool_multiple * n_central_traits pool variants reach
# sampling_min_power. A pool with only a handful of detectable variants yields a
# "weighted" sample that is really those few plus an arbitrary tail.
config.setdefault("sampling_min_power", 0.05)
if not (0 < float(config["sampling_min_power"]) < 1):
    raise ValueError(
        f"sampling_min_power must be in (0, 1), got {config['sampling_min_power']!r}"
    )
# Saturate the sampling weight: past this power a variant is treated as certain
# to be found, so extra power buys no extra representation in the causal set.
# 1.0 is a no-op (power is already bounded by 1), which is where every arm that
# predates the knob sits. It shapes the WEIGHT only -- sampling_min_power above
# still gates pool eligibility on raw power. helpers/causal_power.py explains why
# those are different questions.
config.setdefault("sampling_power_plateau", paths.NO_POWER_PLATEAU)
if not (0 < float(config["sampling_power_plateau"]) <= 1):
    raise ValueError(
        "sampling_power_plateau must be in (0, 1], got "
        f"{config['sampling_power_plateau']!r} (1.0 means no plateau)"
    )
if (float(config["sampling_power_plateau"]) != paths.NO_POWER_PLATEAU
        and config["causal_sampling"] != "power"):
    raise ValueError(
        f"sampling_power_plateau={config['sampling_power_plateau']!r} only has meaning "
        f"under causal_sampling: power, but this run uses {config['causal_sampling']!r}. "
        "A uniform draw has no weight to saturate."
    )
config.setdefault("sampling_min_pool_multiple", 2)
if float(config["sampling_min_pool_multiple"]) < 1:
    raise ValueError(
        "sampling_min_pool_multiple must be >= 1, got "
        f"{config['sampling_min_pool_multiple']!r}"
    )
if config["causal_sampling"] == "power" and not config.get("n_central_traits"):
    raise ValueError(
        "causal_sampling: power requires an explicit n_central_traits -- its pool is "
        "every central selco != 0 variant (no MAF floor), so 'use all eligible' would "
        "make every one of them causative."
    )

# How many causal loci the arm has. No setdefault: every config states it, and a
# silent default here would let a --config typo halve an arm without saying so.
# n_flank_gtex_traits defaults to 50 in rules/common.smk and is validated with it.
for _k in ("n_central_traits", "n_flank_gtex_traits"):
    _v = config.get(_k, 50 if _k == "n_flank_gtex_traits" else None)
    if _v is not None and (int(_v) < 0 or int(_v) != float(_v)):
        raise ValueError(f"{_k} must be a non-negative integer, got {config[_k]!r}")

config.setdefault("ld_ctrl", 0.75)
config.setdefault("dapg_window", 1_000_000)
config.setdefault("fastenloc_total_snps", "auto")
# "coloc_default" -> fastEnloc's --coloc_default_prior (p1=p2=1e-4, p12=1e-5),
# which skips the EM enrichment estimation and therefore writes 3 rather than 5
# .enloc.*.out files (see helpers/paths.py:stage4_output_kinds). "estimated"
# restores the data-driven enrichment, but note that its prior depends on
# -total_variants, which differs ~39x between the two arms under "auto".
config.setdefault("fastenloc_prior", "coloc_default")
if config["fastenloc_prior"] not in {"coloc_default", "estimated"}:
    raise ValueError(
        f"fastenloc_prior must be 'coloc_default' or 'estimated', "
        f"got {config['fastenloc_prior']!r}"
    )

# Split-Q cattle deep history. Both keys or neither: handoff_ticks alone would
# leave the deep segment's mutation rate undefined.
if (config.get("handoff_ticks") is None) != (config.get("deep_Q_scaling") is None):
    raise ValueError(
        "handoff_ticks and deep_Q_scaling must be set together (or both omitted "
        "for a single-Q stage 1)"
    )
# Optional tag (e.g. "r2_0_25") used by paths.py to namespace parallel
# stage-3/4 result sets so multiple ld_ctrl values can coexist in one workdir.
# Empty string preserves the original on-disk layout (existing r2=0.75 outputs).
config.setdefault("output_tag", "")

# O2-specific binary defaults. Override in YAML for other hosts.
config.setdefault("python_binary",   "/home/njc12/miniconda3/envs/coloc_sims/bin/python")
config.setdefault("slim_binary",     "/home/njc12/bin/slim/build/slim")
config.setdefault("dapg_binary",     "/n/data2/hms/dbmi/sunyaev/lab/nconnally/bin/dap/dap_src/dap-g")
config.setdefault("tabix_binary",    "/n/data2/hms/dbmi/sunyaev/lab/nconnally/bin/htslib-1.23.1/tabix")
config.setdefault("bgzip_binary",    "/n/data2/hms/dbmi/sunyaev/lab/nconnally/bin/htslib-1.23.1/bgzip")
config.setdefault("htslib_lib",      "/n/data2/hms/dbmi/sunyaev/lab/nconnally/bin/htslib-1.23.1")
config.setdefault("plink2_binary",   "/home/njc12/bin/plink2")
config.setdefault("fastenloc_binary","/home/njc12/bin/fastenloc/src/fastenloc")
config.setdefault("fastenloc_libpath","/home/njc12/miniconda3/envs/fastenloc_env/lib")
config.setdefault("dap2enloc_binary","/home/njc12/bin/fastenloc/utility/dap2enloc")
# dap-g also needs libgsl.so.28 from the same env we set up for fastenloc.
config.setdefault("dapg_libpath",   "/home/njc12/miniconda3/envs/fastenloc_env/lib")


# ---------- create legacy-filename + stage-2 symlinks before DAG build ----------
#
# This runs at parse time (not onstart) so symlinks exist before any input
# function walks the search dirs. Idempotent.

from helpers import alias as _alias_mod
from pathlib import Path as _Path

# 1) legacy-filename symlinks inside each search dir
_seen_dirs = set()
for _key in ("stage1_search_dirs", "cattle_baseline_search_dirs",
             "stage2_search_dirs"):
    for _d in config.get(_key, []) or []:
        _d = os.path.expanduser(str(_d))
        if _d in _seen_dirs or not os.path.isdir(_d):
            continue
        _seen_dirs.add(_d)
        for _src, _link in _alias_mod.plan_aliases(_d):
            if _link.exists() or _link.is_symlink():
                continue
            try:
                _link.symlink_to(_src.name)
            except OSError as e:
                print(f"[alias] could not symlink {_link} -> {_src.name}: {e}")

# 2) stage-2 search-dir adoption: if a search dir contains the expected
#    gwas_{S1}_gtex_{S2}_maf_{M}/ subdir AND every required stage-2 output
#    file is present (counting both the top-level and ``plink_analysis/``),
#    symlink each into the canonical stage-2 location and touch the marker.
#    All-or-nothing: a partial adoption would let stage 2 re-run and try to
#    overwrite read-only symlinks.

def _required_stage2_files(cfg):
    return [os.path.basename(f) for f in [
        paths.stage2_marker(cfg),
        *[paths.stage2_pheno(cfg, c)            for c in paths.stage2_categories(cfg)],
        *[paths.stage2_geno(cfg, c)             for c in paths.stage2_categories(cfg)],
        *[paths.stage2_vcf(cfg, c)              for c in paths.stage2_categories(cfg)],
        *[paths.stage2_pheno_for_plink(cfg, c)  for c in paths.stage2_categories(cfg)],
    ] if os.path.basename(f) != ".stage2.done"]


_stage2_target = _Path(paths.stage2_inner(config))
_stage2_adopted = _stage2_target.exists() and (_stage2_target / ".stage2.done").exists()
if not _stage2_adopted:
    for _d in config.get("stage2_search_dirs", []) or []:
        _src_dir = _Path(os.path.expanduser(str(_d))) / os.path.basename(paths.stage2_inner(config))
        if not _src_dir.is_dir():
            continue
        # Index every file we can see in src_dir + src_dir/plink_analysis/
        _idx = {}
        for _root in [_src_dir, _src_dir / "plink_analysis"]:
            if _root.is_dir():
                for _f in _root.iterdir():
                    if _f.is_file() or _f.is_symlink():
                        _idx.setdefault(_f.name, _f)
        _missing = [f for f in _required_stage2_files(config) if f not in _idx]
        if _missing:
            print(f"[stage2] {_src_dir} is missing {len(_missing)} required files "
                  f"(e.g. {_missing[0]}); skipping adoption.")
            continue
        try:
            _stage2_target.mkdir(parents=True, exist_ok=True)
        except OSError as e:
            print(f"[stage2] cannot create {_stage2_target}: {e}")
            break
        _linked = 0
        for _name, _src in _idx.items():
            _link = _stage2_target / _name
            if _link.exists() or _link.is_symlink():
                continue
            try:
                _link.symlink_to(_src.resolve())
                _linked += 1
            except OSError as e:
                print(f"[stage2] could not symlink {_link}: {e}")
        try:
            _Path(paths.stage2_marker(config)).touch()
        except OSError:
            pass
        print(f"[stage2] adopted {_linked} files from {_src_dir}")
        _stage2_adopted = True
        break

if (not _stage2_adopted and paths.causal_maf_segment(config)
        and (config.get("stage2_search_dirs") or [])):
    # Not an error: the search dirs are named `gwas_G_gtex_T_maf_<causal floor>`,
    # so a baseline dir simply does not match a run that wants a different causal
    # pool -- which is the correct outcome, since the phenotypes differ. Say so,
    # or "stage 2 is re-running" looks like a bug.
    print(f"[stage2] no search dir matches {os.path.basename(paths.stage2_inner(config))} "
          f"(causal_min_maf={config['causal_min_maf']}); stage 2 will re-run, as it must -- "
          f"the trait set and phenotypes depend on that floor.")


# 2b) Stage-2 provenance guard.
#
# The adoption block above matches on the stage-2 directory's basename, which
# carries causal_min_maf, so it cannot hand this run phenotypes built under a
# different causal floor. What it cannot rule out is a stage-2 directory that
# already sits at the canonical location -- adopted earlier, or left by a prior
# run of this same workdir -- whose parameters have since changed underneath it.
# stage2_params.txt is the oracle: compare it against what is being asked for.

if os.path.exists(paths.stage2_marker(config)):
    _s2_params = paths.stage2_params_file(config)
    if os.path.exists(_s2_params):
        _bad = params_record.stage2_disagreements(config, _s2_params)
        if _bad:
            raise ValueError(
                "The completed stage-2 output at "
                f"{paths.stage2_inner(config)} was produced with different "
                "content-determining parameters:\n"
                + "\n".join(f"  {k}: on disk {d!r} != requested {r!r}" for k, d, r in _bad)
                + "\nUse a distinct workdir (the convention in "
                  "submit_2Mb_r3_multipliers.sh) or delete that stage-2 directory."
            )
    elif paths.causal_maf_segment(config):
        raise ValueError(
            f"{paths.stage2_inner(config)} predates stage2_params.txt, so the causal "
            f"MAF floor its phenotypes were built under cannot be verified -- and this "
            f"run sets causal_min_maf={config['causal_min_maf']}, which is not the "
            f"{paths.LEGACY_CAUSAL_MIN_MAF} every run before that file used. Refusing to "
            f"reuse it: delete that stage-2 directory, or point workdir somewhere fresh."
        )


# 3) Per-stage output adoption from previous workdirs (stages 3-5; stage 2 is
#    handled by the more permissive all-or-nothing block above). For each entry
#    in `previous_workdirs`, walk that dir's stage{3,4,5}/<run_tag>/ subtree
#    and symlink any matching file into <workdir>/stage{N}/<run_tag>/.
#
#    Use case: a controller died, /n/scratch got purged, the user moved
#    outputs to /n/data2, or they want to pool partial progress from a
#    sibling workdir. Symlinks let stage 3's per-trait rules and stage 4's
#    fastenloc/stage 5's plink rules see existing outputs and skip
#    regeneration.
#
#    Caveat: this does PER-FILE adoption. If a rule produces several outputs
#    together (stage 4 fastenloc, stage 5 plink GLM) and only some are
#    present in the previous workdir, Snakemake will rerun that rule and
#    *all* its outputs will be re-produced. Stage 3 dap-g is per-trait so
#    partial adoption helps proportionally.
#
#    NOTE: stage 1 outputs aren't adopted here -- they're already handled
#    by the `find_in_search_dirs` lookups in the stage-1 rules.

_run_tag = paths.stage2_run_tag(config)
_workdir = _Path(paths.workdir(config))


def _adopt_prior_outputs():
    n_total = 0
    for _prev in config.get("previous_workdirs", []) or []:
        _prev = _Path(os.path.expanduser(str(_prev)))
        if not _prev.is_dir():
            print(f"[adopt] previous_workdir {_prev} does not exist; skipping")
            continue
        for _stage in ("stage3", "stage4", "stage5"):
            _src = _prev / _stage / _run_tag
            if not _src.is_dir():
                continue
            _tgt = _workdir / _stage / _run_tag
            _n = 0
            for _src_f in _src.rglob("*"):
                if not (_src_f.is_file() or _src_f.is_symlink()):
                    continue
                _rel = _src_f.relative_to(_src)
                _link = _tgt / _rel
                if _link.exists() or _link.is_symlink():
                    continue
                try:
                    _link.parent.mkdir(parents=True, exist_ok=True)
                    _link.symlink_to(_src_f.resolve())
                    _n += 1
                except OSError as e:
                    print(f"[adopt {_stage}] could not symlink {_link}: {e}")
            if _n > 0:
                print(f"[adopt {_stage}] symlinked {_n} file(s) from {_src}")
            n_total += _n
    return n_total


_adopt_prior_outputs()


# ---------- pipeline dispatch ----------

if config["pipeline"] == "human":
    include: "rules/stage1_human.smk"
elif config["pipeline"] == "human_neutral":
    include: "rules/stage1_human_neutral.smk"
elif config["pipeline"] == "cattle_baseline":
    include: "rules/stage1_cattle_baseline.smk"
elif config["pipeline"] == "cattle_baseline_from_midpoint":
    include: "rules/stage1_cattle_baseline_from_midpoint.smk"
elif config["pipeline"] == "cattle_sel":
    include: "rules/stage1_cattle_sel.smk"
elif config["pipeline"] == "cattle_neutral":
    include: "rules/stage1_cattle_neutral.smk"

include: "rules/common.smk"


# ---------- per-simulation parameters record ----------
#
# Written at onstart rather than as a rule output. onstart fires once per real
# invocation (including `--until stage2` and the stage-5-only controller), adds no
# job to the DAG, changes nothing for the runs already complete on disk, and
# correctly writes nothing under -n. A declared output would instead append a
# pending job to every existing run. Same reasoning as the .fmmaf sidecar in
# rules/common.smk, which is deliberately undeclared so prior runs stay adoptable.

onstart:
    try:
        for _p in params_record.write_run_params(
                config, argv=sys.argv, strict=config.get("params_strict", False)):
            print(f"[params] wrote {_p}")
    except ValueError:
        # The one failure that is a DELIBERATE refusal rather than an accident:
        # params_strict=True and the record on disk disagrees on an ANALYSIS key,
        # i.e. two variants are sharing one output_tag and about to collide.
        # Swallowing it made params_strict gate nothing at all -- the flag could be
        # set, the disagreement found, and the run would carry on regardless.
        raise
    except Exception as e:
        # Anything else -- a read-only workdir, a full disk -- must never be the
        # thing that kills a pipeline. Losing the provenance file is bad; losing a
        # week of DAP-G because we could not write a 4 KB record is worse.
        print(f"[params] WARNING: could not write params file: {e}")


# ---------- top-level target ----------

CATS = paths.stage2_categories(config)


def _all_stage4_outputs(cfg):
    """One fastEnloc output set per GTEx variant (multi-size power-analysis run)."""
    return [out
            for g in paths.stage2_gtex_categories(cfg)
            for out in paths.stage4_outputs(cfg, g)]


rule all:
    input:
        # Stage 4 (fastEnloc) end products -- one set per GTEx variant
        _all_stage4_outputs(config),
        # Stage 5 (plink GLM) per-category sentinels
        [paths.stage5_done(config, c) for c in CATS],


# Convenience targets so users can stop early:
rule stage1:
    input:
        os.path.join(paths.stage1_dir(config), paths.stage1_full_filename(config)),

rule stage2:
    input: paths.stage2_marker(config),

rule stage3:
    input: [paths.stage3_done(config, c) for c in CATS],

rule stage4:
    input: _all_stage4_outputs(config),

rule stage5:
    input: [paths.stage5_done(config, c) for c in CATS],
